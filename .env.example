# deepseek: use DeepSeek's OpenAI-compatible API
# qwen: use Alibaba Cloud Model Studio's OpenAI-compatible API
# Preloaded demo data is selected in the UI and never used as an online fallback.
LLM_PROVIDER=qwen
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=qwen-vl-max
LLM_TIMEOUT_SECONDS=60
PORT=5000
DB_ENGINE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=tcm_demo
